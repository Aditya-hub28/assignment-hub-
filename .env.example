# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=*

# Supabase Configuration
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Default College ID (matches the seeded default college in supabase/schema.sql)
DEFAULT_COLLEGE_ID=00000000-0000-0000-0000-000000000001

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_LOCKOUT_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3

# SMS Provider Mode (options: 'console', 'fast2sms', 'twilio', 'msg91')
SMS_PROVIDER=console
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email SMTP Configuration (Gmail)
EMAIL_PROVIDER=gmail
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

